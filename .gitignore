Release/
# Android build-type source sets must stay tracked. The Debug//Release/ rules above
# (CMake/MSVC output dirs) match case-insensitively on Windows and would otherwise
# swallow app/src/debug and app/src/release.
!android/app/src/debug/
!android/app/src/release/
game-data/
.workbuddy/
*.exe
*.dll
*.app/*
*.desktop
*.zip
*.pcx
*.ncb
*.opt
*.idb
*.plg
*.pdb
*.ilk
*.obj
*.sbr

